# Variáveis obrigatórias em BUILD TIME.
# Como são NEXT_PUBLIC_*, o Next as grava dentro do bundle durante o `next build`.
# Se não estiverem no ambiente do build, o valor vira `undefined` no site publicado
# e o formulário para de enviar lead — não adianta corrigir depois sem refazer o build.
#
# Na Vercel: Project Settings -> Environment Variables (Production + Preview)
# e depois Deployments -> Redeploy SEM "Use existing Build Cache".
#
# Copie este arquivo para `.env` no ambiente local e preencha com os valores reais.

# Hook do SprintHub da LP do evento (/ e /a)
NEXT_PUBLIC_SPRINTHUB_HOOK_URL=https://sprinthub-api-master.sprinthub.app/api/hook/imersao-ari?i=SEU_TENANT&access_token=SEU_TOKEN

# Hook do SprintHub das LPs de captação (/b, /c, /d e /bio)
NEXT_PUBLIC_SPRINTHUB_LPS_HOOK_URL=https://sprinthub-api-master.sprinthub.app/api/hook/lps?i=SEU_TENANT&access_token=SEU_TOKEN
